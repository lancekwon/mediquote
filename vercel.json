{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/((?!h/|q/|api/|hospital\\.html|hospital\\.js|img/).*)",
      "has": [{ "type": "host", "value": "my.dwmedi.kr" }],
      "destination": "https://dwmedi.kr",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/h/:code", "destination": "/hospital.html" },
    { "source": "/q/:token", "destination": "/api/quote?t=:token" },
    { "source": "/hospital", "destination": "/hospital.html" },
    { "source": "/preview", "destination": "/hospital_preview.html" },
    { "source": "/((?!api/|dw-logo\\.png|DW_logo\\.png|manifest\\.json|sw\\.js|hospital\\.html|hospital\\.js|hospital_preview\\.html|app\\.js|img/).*)", "destination": "/index.html" }
  ]
}
